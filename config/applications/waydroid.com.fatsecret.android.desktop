[Desktop Entry]
Type=Application
Name=fatsecret
Exec=waydroid app launch com.fatsecret.android
Icon=@HOME@/.local/share/waydroid/data/icons/com.fatsecret.android.png
Categories=X-WayDroid-App;
X-Purism-FormFactor=Workstation;Mobile;
Actions=app-settings;

[Desktop Action app-settings]
Name=App Settings
Exec=waydroid app intent android.settings.APPLICATION_DETAILS_SETTINGS package:com.fatsecret.android
Icon=@HOME@/.local/share/waydroid/data/icons/com.android.settings.png
