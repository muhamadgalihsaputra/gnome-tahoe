[Desktop Entry]
Type=Application
Name=Niagara Launcher
Exec=waydroid app launch bitpit.launcher
Icon=@HOME@/.local/share/waydroid/data/icons/bitpit.launcher.png
Categories=X-WayDroid-App;
X-Purism-FormFactor=Workstation;Mobile;
Actions=app-settings;

[Desktop Action app-settings]
Name=App Settings
Exec=waydroid app intent android.settings.APPLICATION_DETAILS_SETTINGS package:bitpit.launcher
Icon=@HOME@/.local/share/waydroid/data/icons/com.android.settings.png
