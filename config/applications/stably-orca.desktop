[Desktop Entry]
Name=Orca IDE
GenericName=Agentic Coding IDE
Comment=Electron-based agentic coding IDE by Stably AI
Exec=env GTK_THEME=MacTahoe-Dark-purple stably-orca %U
Terminal=false
Type=Application
Icon=@HOME@/.local/share/icons/stably-orca.png
Categories=Development;IDE;TextEditor;
StartupWMClass=orca
MimeType=x-scheme-handler/stably-orca;
